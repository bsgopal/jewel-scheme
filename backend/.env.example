# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/jewellery_scheme_db

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d

# ─── Razorpay ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Email / SMTP (used for all OTP delivery) ────────────────────
# NOTE: OTPs (registration + password reset) are sent via EMAIL
# For Gmail: use an App Password (not your main password)
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ─── App ─────────────────────────────────────────────────────────
APP_NAME=JewelScheme
FRONTEND_URL=http://localhost:3000
GOLD_RATE_PROVIDER=commodities-api
COMMODITIES_API_KEY=your_commodities_api_key
COMMODITIES_API_URL=https://commodities-api.com/api/convert
COMMODITIES_24K_SYMBOL=BANG-24k
COMMODITIES_22K_SYMBOL=BANG-22k
COMMODITIES_18K_SYMBOL=BANG-18K
COMMODITIES_SILVER_SYMBOL=XAG-BANG
METAL_API_KEY=your_metalpriceapi_key
METAL_API_URL=https://api.metalpriceapi.com/v1/latest
USE_LIVE_METAL_RATES=true
GOLD_RATE_FRESHNESS_MINUTES=60
GOLD_RATE_PREMIUM_MULTIPLIER=1.0508
